{
  "type": "object",
  "description": "Strictly return ONLY ONE of two states: 1) If an error occurs, return ONLY 'errmsg'. 2) If successful, return 'data' and omit 'errmsg'.",
  "properties": {
    "errmsg": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "enum": [
            "ERR-01",
            "ERR-99"
          ]
        },
        "suggestion": {
          "type": "string"
        }
      },
      "required": [
        "errorCode",
        "suggestion"
      ],
      "propertyOrdering": [
        "errorCode",
        "suggestion"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "routineName": {
          "type": "string",
          "description": "Catchy title for the routine."
        },
        "totalDays": {
          "type": "integer",
          "description": "Total calculated duration in days."
        },
        "targetGoal": {
          "type": "object",
          "description": "Routine objective containing a title and the target text.",
          "properties": {
            "title": {
              "type": "string",
              "description": "Title of the goal."
            },
            "targetText": {
              "type": "string",
              "description": "Routine objective. Maximum 65 characters."
            }
          },
          "required": [
            "title",
            "targetText"
          ],
          "propertyOrdering": [
            "title",
            "targetText"
          ]
        },
        "dailySchedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "integer"
              },
              "phase": {
                "type": "string",
                "description": "Title/Phase for the day. Maximum 32 characters."
              },
              "activities": {
                "type": "array",
                "description": "List of detailed action items including timing, SPF levels, side rotation, and post-tan care.",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "day",
              "phase",
              "activities"
            ],
            "propertyOrdering": [
              "day",
              "phase",
              "activities"
            ]
          }
        }
      },
      "required": [
        "routineName",
        "totalDays",
        "targetGoal",
        "dailySchedule"
      ],
      "propertyOrdering": [
        "routineName",
        "totalDays",
        "targetGoal",
        "dailySchedule"
      ]
    }
  },
  "propertyOrdering": [
    "errmsg",
    "data"
  ]
}
