        "errmsg": {
            "type": "object",
            "properties": {
                "errorCode": {
                    "type": "string",
                    "enum": [
                        "ERROR_NON_SKIN",
                        "ERROR_TOO_MANY_FACES",
                        "ERROR_NO_FACE_DETECTED",
                        "ERROR_IMAGE_BLURRY",
                        "ERROR_IMAGE_GLARE",
                        "ERROR_LIGHTING_POOR",
                        "ERROR_SYSTEM"
                    ]
                },
                "suggestion": { "type": "string" }
            },
            "required": ["errorCode", "suggestion"]
        },
        "data": {
            "type": "object",
            "properties": {
                "skinTone": {
                    "type": "string",
                    "enum": ["Very Fair Skin", "Fair Skin", "Medium Skin", "Olive Skin", "Brown Skin", "Dark Skin"]
                },
                "skinAge": { "type": "string" },
                "hydration": {
                    "type": "string",
                    "enum": ["Critically Dry", "Dehydrated", "Hydrated", "Over-Hydrated"]
                },
                "skinType": {
                    "type": "string",
                    "enum": ["Normal Skin", "Dry Skin", "Oily Skin", "Combination Skin", "Sensitive Skin"]
                }
            },
            "required": ["skinTone", "skinAge", "hydration", "skinType"]
        }
    }
}
