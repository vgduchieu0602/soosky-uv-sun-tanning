# Cong app Node lang nghe. Trong Docker, compose ghi de thanh 3000.
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Cong Docker publish ra VPS (chi dung khi chay bang docker compose).
# Da dung tren VPS: 3000 = soosky-plant-care-api, 3001 = soosky-storm-api,
# 3002 = soosky-weather-marine-api. Kiem tra truoc: sudo ss -ltnp | grep :3003
HOST_PORT=3003

# Tran RAM container va V8 heap. Mac dinh phu hop VPS 1GB.
# VPS 512MB: MEM_LIMIT=320m, NODE_MAX_OLD_SPACE_MB=192
MEM_LIMIT=400m
NODE_MAX_OLD_SPACE_MB=320

# Express "trust proxy". Dung 1 khi dung sau dung MOT reverse proxy.
# Dat false khi API expose truc tiep, neu khong X-Forwarded-For co the bi gia mao.
HTTP_TRUST_PROXY=1

# PHAI co ten database truoc dau ? -- thieu la du lieu vao database ten "test".
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/soosky_uv_sun_tanning?retryWrites=true&w=majority

# API key cho Current Weather va Forecast5 APIs cua OpenWeatherMap.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Gemini API key cho phan tich da mat. Co the doi model neu can.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=

# Kich thuoc tep anh toi da khi tai len (MB).
MAX_IMAGE_MB=8
